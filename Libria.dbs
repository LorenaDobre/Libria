<?xml version="1.0" encoding="UTF-8" ?>
<project name="PostgreSQL" database="PostgreSQL" id="82462922-ed15-42b2-9131-59eb1f1b5a2e" >
	<schema name="public" catalogname="libria-db" >
		<comment><![CDATA[standard public schema]]></comment>
		<table name="book_genres" row_count="0" >
			<column name="book_id" type="integer" mandatory="y" />
			<column name="genre_id" type="integer" mandatory="y" />
			<index name="book_genres_pkey" unique="PRIMARY_KEY" >
				<column name="book_id" />
				<column name="genre_id" />
			</index>
			<fk name="book_genres_book_id_fkey" to_schema="libria-db.public" to_table="books" delete_action="cascade" options="" >
				<fk_column name="book_id" pk="id" />
			</fk>
			<fk name="book_genres_genre_id_fkey" to_schema="libria-db.public" to_table="genres" delete_action="cascade" options="" >
				<fk_column name="genre_id" pk="id" />
			</fk>
		</table>
		<table name="book_themes" row_count="0" >
			<column name="book_id" type="integer" mandatory="y" />
			<column name="theme_id" type="integer" mandatory="y" />
			<index name="book_themes_pkey" unique="PRIMARY_KEY" >
				<column name="book_id" />
				<column name="theme_id" />
			</index>
			<fk name="book_themes_book_id_fkey" to_schema="libria-db.public" to_table="books" delete_action="cascade" options="" >
				<fk_column name="book_id" pk="id" />
			</fk>
			<fk name="book_themes_theme_id_fkey" to_schema="libria-db.public" to_table="themes" delete_action="cascade" options="" >
				<fk_column name="theme_id" pk="id" />
			</fk>
		</table>
		<table name="books" row_count="0" >
			<column name="id" type="integer" mandatory="y" >
				<identity><![CDATA[GENERATED BY DEFAULT AS IDENTITY]]></identity>
			</column>
			<column name="title" type="varchar" length="200" mandatory="y" />
			<column name="author" type="varchar" length="150" mandatory="y" />
			<column name="description" type="text" />
			<column name="publication_year" type="integer" />
			<column name="pages" type="integer" />
			<column name="cover_url" type="text" />
			<column name="isbn13" type="varchar" length="13" />
			<column name="is_active" type="boolean" mandatory="y" >
				<defo><![CDATA[true]]></defo>
			</column>
			<column name="created_at" type="timestamptz" mandatory="y" >
				<defo><![CDATA[CURRENT_TIMESTAMP]]></defo>
			</column>
			<column name="updated_at" type="timestamptz" mandatory="y" >
				<defo><![CDATA[CURRENT_TIMESTAMP]]></defo>
			</column>
			<index name="books_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="books_isbn13_key" unique="UNIQUE_KEY" >
				<column name="isbn13" />
			</index>
			<index name="uq_book_title_author" unique="UNIQUE_KEY" >
				<column name="title" />
				<column name="author" />
			</index>
			<constraint name="books_pages_check" type="CHECK" options="" >
				<string><![CDATA[pages > 0]]></string>
			</constraint>
			<constraint name="books_publication_year_check" type="CHECK" options="" >
				<string><![CDATA[publication_year > 0]]></string>
			</constraint>
		</table>
		<table name="genres" row_count="0" >
			<column name="id" type="integer" mandatory="y" >
				<identity><![CDATA[GENERATED BY DEFAULT AS IDENTITY]]></identity>
			</column>
			<column name="name" type="varchar" length="100" mandatory="y" />
			<column name="description" type="text" />
			<column name="created_at" type="timestamptz" mandatory="y" >
				<defo><![CDATA[CURRENT_TIMESTAMP]]></defo>
			</column>
			<index name="genres_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="genres_name_key" unique="UNIQUE_KEY" >
				<column name="name" />
			</index>
		</table>
		<table name="themes" row_count="0" >
			<column name="id" type="integer" mandatory="y" >
				<identity><![CDATA[GENERATED BY DEFAULT AS IDENTITY]]></identity>
			</column>
			<column name="name" type="varchar" length="100" mandatory="y" />
			<column name="description" type="text" />
			<column name="created_at" type="timestamptz" mandatory="y" >
				<defo><![CDATA[CURRENT_TIMESTAMP]]></defo>
			</column>
			<index name="themes_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="themes_name_key" unique="UNIQUE_KEY" >
				<column name="name" />
			</index>
		</table>
	</schema>
